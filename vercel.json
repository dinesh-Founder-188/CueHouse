{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": [
        "assets/**",
        "3d/**",
        "avatars/**",
        "fonts/**",
        "images/**",
        "mobile/**",
        "patterns/**",
        "services/**",
        "story/**",
        "*.html",
        "*.svg",
        "*.png",
        "*.jpg",
        "*.webp",
        "*.ico",
        "*.txt",
        "*.xml"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
